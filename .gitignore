# Dades identificatives (adreça, cadastre, registre, parts, preus) — MAI al repositori
docs/privat/

# Documents originals (dades personals) — no han d'entrar al repositori
*.pdf
*.docx
*.xlsx
*.zip

# Secrets de Home Assistant
secrets.yaml
.env
*.key
*.pem

# Sistema
.DS_Store
Thumbs.db
desktop.ini

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Runtime de Home Assistant — es genera al local i NO es versiona.
# Sense aquestes línies, «desplega.sh» avortaria sempre pel pas 1
# (arbre brut), perquè HA reescriu aquests fitxers contínuament.
config/.storage/
config/.cloud/
config/backups/
config/deps/
config/tts/
config/www/
config/.uuid
config/*.db
config/*.db-shm
config/*.db-wal
config/home-assistant.log*
config/known_devices.yaml
config/.HA_VERSION
config/.ha_run.lock
config/.cache/
config/blueprints/
config/image/

# Dades del servidor Matter: hi ha les CLAUS dels aparells emparellats.
# No es versiona (són secrets), però SÍ que ha d'entrar a la còpia de
# seguretat: perdre-ho obliga a reemparellar, i reemparellar parteix les sèries.
matter-data/
